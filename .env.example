# --- AI (required for assistant, crop scan, AI brief) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Data (optional, improves coverage) ---
# Free key from https://data.gov.in (sample key is limited to 10 mandi records per call)
DATA_GOV_IN_API_KEY=
# Free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/ (crop-residue fire alerts)
NASA_FIRMS_MAP_KEY=

# --- Alert delivery (optional) ---
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
# Generic JSON webhook (e.g. your own IVR / Slack / n8n flow)
ALERT_WEBHOOK_URL=
ALERT_INTERVAL_MIN=60

PORT=3000
